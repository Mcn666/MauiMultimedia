@* @page "/archiveviewer" — 已由 ContentPage 动态加载 *@
<div class="viewer-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack">← 返回</button>
        <span class="v-file-emoji">📦</span>
        <span class="v-title">@fileName</span>
        @if (items.Count > 0)
        {
            <span class="v-count">- @(items.Count) 项</span>
        }
    </div>
    <div class="items-header">
        <span class="col-icon"></span>
        <span class="col-name sortable">名称</span>
        <span class="col-count sortable">大小</span>
        <span class="col-date sortable">修改时间</span>
    </div>

    @if (isLoading)
    {
        <div class="loading-box">
            <div class="spinner">@* spinner *@</div>
            <span>正在读取...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-box">@errorMessage</div>
    }
    else if (items.Count == 0)
    {
        <div class="empty-box">压缩文件为空</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(toast))
        {
            <div class="toast">@toast</div>
        }
        <div class="list-scroll">
            @RenderTree(nodes)
        </div>
    }
</div>

@if (showPasswordPrompt)
{
    <div class="pw-overlay">
        <div class="pw-dialog">
            <div class="pw-title">🔒 此压缩文件需要密码</div>
            <input type="password" id="_pw" class="pw-input" placeholder="请输入密码" />
            <div class="pw-actions">
                <button class="pw-btn" @onclick="CancelPassword">取消</button>
                <button class="pw-btn-primary" @onclick="DoPassword">确定</button>
            </div>
        </div>
    </div>
}
