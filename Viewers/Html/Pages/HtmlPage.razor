@page "/htmlviewer"
@using Microsoft.JSInterop
@using MauiMultimedia.Core.Abstractions
@using System.Linq
@using MauiMultimedia.Viewers.Html.Services
@inject NavigationManager Navigation
@inject IFileNavigationState NavState
@inject IMauiNavigation MauiNav
@inject IJSRuntime JS

<div class="v-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack">← 返回</button>
        <button class="v-btn" disabled="@(hasPrev ? null : true)" @onclick="GoPrev">← 上一个</button>
        <span class="v-title" title="@filePath">@fileName</span>
        <span class="v-pos">@(currentIndex >= 0 ? $"{currentIndex + 1}/{fileList.Count}" : "")</span>
        <button class="v-btn" disabled="@(hasNext ? null : true)" @onclick="GoNext">下一个 →</button>
    </div>

    @if (isLoading)
    {
        <div class="v-status"><div class="v-spinner"></div><span>正在加载...</span></div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="v-status v-status--err">⚠️ @errorMessage</div>
    }
    else
    {
        <div class="v-frame-wrap">
            <iframe srcdoc="@htmlContent" class="v-frame"></iframe>
        </div>
    }
</div>

@code {
    private static readonly HashSet<string> Exts = new(StringComparer.OrdinalIgnoreCase)
    {
        ".html", ".htm", ".mht", ".mhtml"
    };

    private string filePath = "";
    private string fileName = "";
    private string? htmlContent;
    private bool isLoading = true;
    private string? errorMessage;
    private List<string> fileList = new();
    private int currentIndex = -1;

    private bool hasPrev => currentIndex > 0;
    private bool hasNext => currentIndex >= 0 && currentIndex < fileList.Count - 1;

    protected override async Task OnInitializedAsync()
    {
        await JS.InvokeVoidAsync("eval",
            "document.documentElement.style.overflowY = 'hidden'");

        fileList = NavState.CurrentDirectoryFiles?
            .Where(f => Exts.Contains(Path.GetExtension(f))).ToList() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = NavState.CurrentFilePath
            ?? uri.Query.TrimStart('?').Split('&')
                .Select(p => p.Split('=', 2))
                .Where(kv => kv.Length == 2 && kv[0] == "path")
                .Select(kv => Uri.UnescapeDataString(kv[1]))
                .FirstOrDefault() ?? "";

        if (string.IsNullOrEmpty(path))
        {
            errorMessage = "未指定文件路径";
            isLoading = false;
            return;
        }

        filePath = path;
        fileName = Path.GetFileName(filePath);
        currentIndex = fileList.FindIndex(f =>
            string.Equals(f, filePath, StringComparison.OrdinalIgnoreCase));

        await LoadContentAsync();
    }

    private async Task LoadContentAsync()
    {
        isLoading = true;
        errorMessage = null;
        htmlContent = null;

        try
        {
            var fileInfo = new FileInfo(filePath);
            if (!fileInfo.Exists)
            {
                errorMessage = "文件不存在";
                return;
            }

            var ext = Path.GetExtension(filePath);
            var isMhtml = string.Equals(ext, ".mht", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(ext, ".mhtml", StringComparison.OrdinalIgnoreCase);

            var styleTag = "<style>html,body{background:var(--bg-viewport,#1a1a1a);margin:0;padding:0}</style>\n";

            if (isMhtml)
            {
                MhtmlParser.ParseResult result = null!;
                await Task.Run(() => { result = MhtmlParser.Parse(filePath); });

                // 通过 JS 创建 Blob URL 并替换占位符
                htmlContent = await InjectBlobUrls(result);
                htmlContent = styleTag + htmlContent;
            }
            else
            {
                htmlContent = await Task.Run(() =>
                {
                    var content = File.ReadAllText(filePath);
                    var dir = Path.GetDirectoryName(filePath);
                    if (dir != null)
                        content = ResourceInliner.Inline(content, dir);
                    return styleTag + content;
                });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败：{ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> InjectBlobUrls(MhtmlParser.ParseResult result)
    {
        if (result.Resources.Count == 0) return result.HtmlBody;

        // 将资源批量传给 JS，JS 创建 Blob URL 并返回 token→url 映射
        var entries = result.Resources.Select(r => new
        {
            token = $"__BLOB_{Array.IndexOf(result.Resources.ToArray(), r)}__",
            base64 = Convert.ToBase64String(r.Data),
            mime = r.MimeType
        }).ToArray();

        var json = System.Text.Json.JsonSerializer.Serialize(entries);
        var urlMap = await JS.InvokeAsync<Dictionary<string, string>>("eval", $@"
            (function() {{
                var map = {{}};
                var list = {json};
                for (var i = 0; i < list.length; i++) {{
                    var e = list[i];
                    var bin = atob(e.base64);
                    var arr = new Uint8Array(bin.length);
                    for (var j = 0; j < bin.length; j++) arr[j] = bin.charCodeAt(j);
                    map[e.token] = URL.createObjectURL(new Blob([arr], {{type: e.mime}}));
                }}
                return map;
            }})()
        ");

        // 在 C# 中完成所有占位符替换（避免 JS eval 大字符串的坑）
        var html = result.HtmlBody;
        foreach (var (token, url) in urlMap)
            html = html.Replace(token, url);
        return html;
    }

    private void GoBack()
    {
        _ = MauiNav.GoBackAsync();
    }

    private void GoPrev()
    {
        if (!hasPrev) return;
        currentIndex--; filePath = fileList[currentIndex];
        fileName = Path.GetFileName(filePath);
        _ = LoadContentAsync();
    }

    private void GoNext()
    {
        if (!hasNext) return;
        currentIndex++; filePath = fileList[currentIndex];
        fileName = Path.GetFileName(filePath);
        _ = LoadContentAsync();
    }
}
