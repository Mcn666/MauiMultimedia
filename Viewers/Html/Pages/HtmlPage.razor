@* @page "/htmlviewer" — 已由 ContentPage 动态加载 *@
@using Microsoft.JSInterop
@using MauiMultimedia.Core.Abstractions
@using System.Linq
@using MauiMultimedia.Viewers.Html.Services
@inject NavigationManager Navigation
@inject IFileNavigationState NavState
@inject IMauiNavigation MauiNav
@inject IJSRuntime JS
@inject IFileSystemService FileSystem
@implements IDisposable

<div class="v-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack">← 返回</button>
        <FileNavDropdown FileList="fileList" CurrentIndex="currentIndex" OnFileSelected="OnFileSelected" />
    </div>

    @if (isLoading)
    {
        <div class="v-status"><div class="v-spinner"></div><span>正在加载...</span></div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="v-status v-status--err">⚠️ @errorMessage</div>
    }
    else
    {
        <div class="v-frame-wrap">
            <iframe srcdoc="@htmlContent" class="v-frame"></iframe>
        </div>
    }
</div>

@code {
    private static readonly HashSet<string> Exts = new(StringComparer.OrdinalIgnoreCase)
    {
        ".html", ".htm", ".mht", ".mhtml"
    };

    private string filePath = "";
    private string fileName = "";
    private string? htmlContent;
    private bool isLoading = true;
    private string? errorMessage;
    private List<string> fileList = new();
    private int currentIndex = -1;

    [Inject] private IFileServerService FileServer { get; set; } = null!;
    private readonly Dictionary<string, string> _servedTokens = new(); // .html 图片：路径 -> token
    private readonly List<string> _mhtmlTempFiles = new();            // .mht 抽取出的临时文件
    private readonly List<string> _mhtmlTokens = new();               // .mht 资源 token

    protected override async Task OnInitializedAsync()
    {
        await JS.InvokeVoidAsync("eval",
            "document.documentElement.style.overflowY = 'hidden'");

        fileList = NavState.CurrentDirectoryFiles?
            .Where(f => Exts.Contains(Path.GetExtension(f))).ToList() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = NavState.CurrentFilePath
            ?? uri.Query.TrimStart('?').Split('&')
                .Select(p => p.Split('=', 2))
                .Where(kv => kv.Length == 2 && kv[0] == "path")
                .Select(kv => Uri.UnescapeDataString(kv[1]))
                .FirstOrDefault() ?? "";

        if (string.IsNullOrEmpty(path))
        {
            errorMessage = "未指定文件路径";
            isLoading = false;
            return;
        }

        filePath = path;
        fileName = Path.GetFileName(filePath);
        currentIndex = fileList.FindIndex(f =>
            string.Equals(f, filePath, StringComparison.OrdinalIgnoreCase));

        await LoadContentAsync();
    }

    private async Task LoadContentAsync()
    {
        isLoading = true;
        errorMessage = null;
        htmlContent = null;
        RevokeAndCleanup(); // 释放上一份文件占用的 token / 临时文件

        try
        {
            var fileInfo = new FileInfo(filePath);
            if (!fileInfo.Exists)
            {
                errorMessage = "文件不存在";
                return;
            }

            var ext = Path.GetExtension(filePath);
            var isMhtml = string.Equals(ext, ".mht", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(ext, ".mhtml", StringComparison.OrdinalIgnoreCase);

            var styleTag = "<style>html,body{background:var(--bg-viewport,#111111);margin:0;padding:0}</style>\n";

            if (isMhtml)
            {
                MhtmlParser.ParseResult result = null!;
                string served = "";
                await Task.Run(() =>
                {
                    var bytes = File.ReadAllBytes(filePath);
                    result = MhtmlParser.Parse(bytes);
                    // 抽取内嵌资源到临时文件并经 loopback 服务按 token 提供
                    served = ServeMhtmlResources(result);
                });
                htmlContent = styleTag + served;
            }
            else
            {
                htmlContent = await Task.Run(async () =>
                {
                    var bytes = await File.ReadAllBytesAsync(filePath);
                    var content = System.Text.Encoding.UTF8.GetString(bytes);
                    var dir = Path.GetDirectoryName(filePath);
                    if (dir != null)
                        content = ResourceInliner.Inline(content, dir, FileServer, _servedTokens);
                    return styleTag + content;
                });
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败：{ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // 把 MHTML 内嵌资源抽取到临时文件，用同一个 loopback FileServer 按 token
    // 提供（与 .html 的图片一致），避免在 C# 托管堆里 base64 化全部资源、
    // 也避免 Blob URL 从不吊销的泄漏。占位符 __BLOB_n__ 替换为 served URL。
    private string ServeMhtmlResources(MhtmlParser.ParseResult result)
    {
        var html = result.HtmlBody;
        if (result.Resources.Count == 0) return html;

        var tempDir = Path.Combine(FileSystem.GetCacheDirectory(), "MauiMM_Html", Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(tempDir);

        for (int i = 0; i < result.Resources.Count; i++)
        {
            var res = result.Resources[i];
            var ext = MimeToExt(res.MimeType, res.Location);
            var tmp = Path.Combine(tempDir, $"{i}{ext}");
            File.WriteAllBytes(tmp, res.Data);
            _mhtmlTempFiles.Add(tmp);

            var tok = FileServer.RegisterFile(tmp);
            _mhtmlTokens.Add(tok);
            var url = $"{FileServer.BaseUrl}/file?token={tok}";
            html = html.Replace($"__BLOB_{i}__", url);
        }
        return html;
    }

    // 离开当前文件 / 页面时吊销所有已注册 token 并删除临时文件，
    // 防止 loopback 服务持续可访问旧文件、临时文件堆积。
    private void RevokeAndCleanup()
    {
        foreach (var tok in _servedTokens.Values)
            try { FileServer.UnregisterFile(tok); } catch { }
        _servedTokens.Clear();

        foreach (var tok in _mhtmlTokens)
            try { FileServer.UnregisterFile(tok); } catch { }
        _mhtmlTokens.Clear();

        foreach (var f in _mhtmlTempFiles)
            try { File.Delete(f); } catch { }
        _mhtmlTempFiles.Clear();
    }

    private static string MimeToExt(string mime, string location)
    {
        var ext = mime.ToLowerInvariant() switch
        {
            "image/png" => ".png",
            "image/jpeg" => ".jpg",
            "image/gif" => ".gif",
            "image/webp" => ".webp",
            "image/bmp" => ".bmp",
            "image/x-icon" => ".ico",
            "image/svg+xml" => ".svg",
            "image/avif" => ".avif",
            "text/css" => ".css",
            "text/javascript" or "application/javascript" or "application/x-javascript" => ".js",
            "application/json" => ".json",
            "text/html" => ".html",
            "text/plain" => ".txt",
            "application/xml" => ".xml",
            "font/woff" => ".woff",
            "font/woff2" => ".woff2",
            "font/ttf" or "application/x-font-ttf" => ".ttf",
            "font/otf" => ".otf",
            "application/vnd.ms-fontobject" => ".eot",
            _ => Path.GetExtension(location) is { Length: > 0 } e ? e.ToLowerInvariant() : ".bin"
        };
        return ext;
    }

    public void Dispose() => RevokeAndCleanup();

    private void GoBack()
    {
        _ = MauiNav.GoBackAsync();
    }

    private void OnFileSelected(int index)
    {
        if (index < 0 || index >= fileList.Count || index == currentIndex) return;
        currentIndex = index;
        filePath = fileList[currentIndex];
        fileName = Path.GetFileName(filePath);
        _ = LoadContentAsync();
    }
}
