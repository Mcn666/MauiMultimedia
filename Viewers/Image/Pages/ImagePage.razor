@* ImagePage.razor v2 — 8 层 z-index 组件化架构 *@

<div class="viewer-page @(showToolbar ? "chrome-toolbar" : "") @(showFilmstrip ? "chrome-filmstrip" : "")"
     @onclick="OnPageClick">
    @* z=0 *@
    <div class="viewport-bg"></div>

    @if (!stitchMode)
    {
        @* z=1: Image Viewport *@
        <ImageViewport ImageSource="@imageSource"
                       PlaceholderSource="@placeholderSource"
                       Instant="@_instantLoad"
                       FileName="@fileName"
                       ZoomFitMode="@zoomFitMode"
                       DisplayZoom="@displayZoom"
                       ZoomReady="@(_zoomComputed || stitchMode)"
                       PanX="@panX" PanY="@panY"
                       HasPrev="@hasPrev"
                       HasNext="@hasNext"
                       ViewportWidth="@vpWidth"
                       OnNavPrev="GoPrev"
                       OnNavNext="GoNext"
                       OnWheel="OnWheel"
                       OnKeyDown="OnKeyDown"
                       OnDoubleClick="OnDoubleClick"
                       OnPointerDown="OnPointerDown"
                       OnPointerMove="OnPointerMove"
                       OnPointerUp="OnPointerUp" />

        @* z=2: Loading / Error *@
        <ImageLoading IsLoading="isLoading" ErrorMessage="@errorMessage" />

        @* z=3: Info HUD *@
        <ImageHUD Resolution="@(imageWidth > 0 ? $"{imageWidth}x{imageHeight}" : "")"
                 FileSize="@fileSizeDisplay"
                 Format="@imageFormat"
                 Faded="@(!showHUD)" />

        @* z=4: Gesture Layer *@
        <GestureLayer />

        @* z=5: Filmstrip *@
        <ImageFilmstrip @ref="filmstripRef"
                        Items="@_filmstripThumbnails"
                        CurrentIndex="@currentIndex"
                        Hidden="@(!showFilmstrip)"
                        OnItemClick="OnFilmstripClick" />
    }
    else
    {
        @* Stitch mode renders differently *@
        @if (stitchImages != null)
        {
            <div style="position:absolute;top:0;right:0;bottom:0;left:0;z-index:1;display:flex;flex-direction:column;">
                <div class="v-stitch-container" @onscroll="OnStitchScroll">
                    <div class="v-stitch-content" style="position:relative; width:100%; height:@(_stitchTotalHeight)px;">
                        @for (int i = _stitchVisibleStart; stitchImages != null && i <= _stitchVisibleEnd && i < stitchImages.Count; i++)
                        {
                            var si = stitchImages[i];
                            var w = (_stitchContentWidth > 0 ? _stitchContentWidth : (vpWidth > 0 ? vpWidth : 800)) * _stitchZoom;
                            var h = si.Width > 0 ? w * si.Height / si.Width : w * 0.75;
                            var top = _stitchTop.Length > i ? _stitchTop[i] : 0;
                            <div style="position:absolute; top:@(top)px; left:50%; transform:translateX(-50%); width:@(w)px; height:@(h)px;" @key="i">
                                <img class="v-stitch-img" alt="@si.FileName"
                                     src="@GetStitchSrc(i)"
                                     style="display:block; width:100%; height:100%; object-fit:contain;" />
                                <span class="v-stitch-label">@si.FileName</span>
                            </div>
                        }
                    </div>
                    @if (_stitchLoadedCount < stitchImages!.Count)
                    {
                        <div class="v-stitch-progress">Loading @_stitchLoadedCount/@stitchImages!.Count ...</div>
                    }
                </div>

                <StitchToolbar PositionText="@(currentIndex >= 0 ? $"{currentIndex + 1}/{fileList.Count}" : "")"
                               ZoomDisplay="@GetDisplayZoom()"
                               Hidden="@(!showToolbar)"
                               ZoomOutDisabled="@(_stitchZoom <= 0.1f)"
                               ZoomInDisabled="@(_stitchZoom >= 5.0f)"
                               Gap="@_stitchGap"
                               OnExit="ToggleStitch"
                               OnZoomOut="ZoomOut"
                               OnZoomIn="ZoomIn"
                               OnGapUp="StitchGapUp"
                               OnGapDown="StitchGapDown" />
            </div>
        }
        else if (stitchError != null)
        {
            <div class="error-overlay">@stitchError</div>
        }
    }

    @* z=6: Toolbar *@
    <ImageToolbar FileList="@fileList"
                 CurrentIndex="@currentIndex"
                 ZoomDisplay="@GetDisplayZoom()"
                 FitToggleText="@GetFitToggleText()"
                 FitToggleTitle="@GetFitToggleTitle()"
                 Hidden="@(!showToolbar || stitchMode)"
                 ZoomFitMode="@IsToolbarZoomFit"
                 StitchMode="@stitchMode"
                 ShowStitch="@canStitch"
                 ZoomOutDisabled="@((stitchMode ? _stitchZoom <= 0.1f : displayZoom <= MinZoom))"
                 ZoomInDisabled="@((stitchMode ? _stitchZoom >= 5.0f : displayZoom >= MaxZoom))"
                 OnGoBack="GoBack"
                 OnFileSelected="OnFileDropSelected"
                 OnZoomOut="ZoomOut"
                 OnZoomIn="ZoomIn"
                 OnToggleFit="ToggleFitActual"
                 OnToggleStitch="ToggleStitch"
                 OnToggleDetails="ToggleDetails" />

    @* z=7: Detail Panel *@
    @if (showDetails)
    {
        <DetailPanel FileName="@fileName"
                     FilePath="@filePath"
                     Resolution="@(imageWidth > 0 ? $"{imageWidth} x {imageHeight}" : "-")"
                     FileSize="@fileSizeDisplay"
                     Format="@imageFormat"
                     CreatedTime="@(_fileCreationTime ?? "-")"
                     ModifiedTime="@(_fileLastWriteTime ?? "-")"
                     OnClose="CloseDetails" />
    }
</div>
