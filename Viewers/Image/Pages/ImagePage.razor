@page "/imageviewer"

<div class="viewer-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack" title="返回 (Esc)">← 返回</button>
        <button class="v-btn v-btn-nav" disabled="@(hasPrev ? null : true)" @onclick="GoPrev" title="上一个 (←)">←</button>

        <span class="v-title" title="@filePath">@fileName</span>
        <span class="v-pos">@(currentIndex >= 0 ? $"{currentIndex + 1}/{fileList.Count}" : "")</span>

        <button class="v-btn v-btn-nav" disabled="@(hasNext ? null : true)" @onclick="GoNext" title="下一个 (→)">→</button>

        <span class="v-sep"></span>

        <span class="v-zoom">@(((stitchMode ? _stitchZoom : displayZoom) * 100).ToString("F0"))%</span>
        <button class="v-btn v-btn-icon" @onclick="ZoomOut" disabled="@((stitchMode ? _stitchZoom <= 0.5f : displayZoom <= MinZoom) ? true : null)" title="缩小 (-)">−</button>
        <button class="v-btn v-btn-icon" @onclick="ZoomIn" disabled="@((stitchMode ? _stitchZoom >= 3.0f : displayZoom >= MaxZoom) ? true : null)" title="放大 (+)">+</button>
        <button class="v-btn v-btn-sm" @onclick="ZoomFit">适应</button>
        <button class="v-btn v-btn-sm" @onclick="ZoomActual">原大</button>

        <span class="v-sep"></span>
        @if (canStitch)
        {
            <button class="v-btn v-btn-sm v-stitch-btn @(stitchMode ? "v-btn-active" : "")" @onclick="ToggleStitch" title="拼接模式">📐 拼接</button>
            <span class="v-sep"></span>
        }
        <button class="v-btn v-btn-sm v-detail-btn" @onclick="ToggleDetails" title="图片详情">ℹ️</button>
    </div>

    @if (isLoading)
    {
        <div class="v-status"><div class="v-spinner"></div><span>正在加载...</span></div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="v-status v-status--err">⚠️ @errorMessage</div>
    }
    else if (stitchMode && stitchImages != null)
    {
        <div class="v-stitch-container">
            @foreach (var si in stitchImages)
            {
                <img src="@si.BlobUrl" alt="" class="v-stitch-img" loading="lazy"
                     style="aspect-ratio:@si.Width/@si.Height; max-width:min(100%, @((int)(800 * _stitchZoom))px)" />
            }
        </div>
    }
    else if (stitchMode && stitchError != null)
    {
        <div class="v-status v-status--err">⚠️ @stitchError</div>
    }
    else
    {
            <div class="image-viewport @(zoomFitMode ? "fit" : "free")"
                 tabindex="0"
                 @onwheel="OnWheel"
                 @onkeydown="OnKeyDown"
                 @ondblclick="OnDoubleClick"
                 @onpointerdown="OnPointerDown"
                 @onpointermove="OnPointerMove"
                 @onpointerup="OnPointerUp"
                 @onpointercancel="OnPointerUp"
                 @onpointerleave="OnPointerUp"
                 @ontouchstart:preventDefault="true"
                 @ontouchstart="OnTouchStart"
                 @ontouchmove="OnTouchMove"
                 @ontouchend="OnTouchEnd">

                <div class="img-slide @(_slideInProgress ? "sliding" : "")" style="transform: translateX(@(_slideOffsetPercent)%)">
                    <div class="img-wrap" style="@GetZoomStyle()">
                        <img src="@imageSource" alt="@fileName" class="img-display" />
                    </div>
                </div>

                <div class="img-info">
                    <span>@(imageWidth > 0 ? $"{imageWidth}×{imageHeight}" : "")</span>
                    <span class="i-sep">|</span>
                    <span>@fileSizeDisplay</span>
                    <span class="i-sep">|</span>
                    <span>@imageFormat</span>
                </div>
            </div>
    }

    @* 详情面板 *@
    @if (showDetails)
    {
        <div class="v-detail-overlay" @onclick="CloseDetails"></div>
        <div class="v-detail-panel">
            <div class="v-detail-header">
                <span>📄 图片详情</span>
                <button class="v-detail-close" @onclick="CloseDetails">✕</button>
            </div>
            <div class="v-detail-body">
                <div class="v-detail-row">
                    <span class="v-detail-label">文件名</span>
                    <span class="v-detail-value">@fileName</span>
                </div>
                <div class="v-detail-row">
                    <span class="v-detail-label">路径</span>
                    <span class="v-detail-value v-detail-path" title="@filePath">@filePath</span>
                </div>
                <div class="v-detail-row">
                    <span class="v-detail-label">尺寸</span>
                    <span class="v-detail-value">@(imageWidth > 0 ? $"{imageWidth} × {imageHeight}" : "-")</span>
                </div>
                <div class="v-detail-row">
                    <span class="v-detail-label">大小</span>
                    <span class="v-detail-value">@fileSizeDisplay</span>
                </div>
                <div class="v-detail-row">
                    <span class="v-detail-label">格式</span>
                    <span class="v-detail-value">@imageFormat</span>
                </div>
                <div class="v-detail-row">
                    <span class="v-detail-label">创建时间</span>
                    <span class="v-detail-value">@(string.IsNullOrEmpty(filePath) ? "-" : File.GetCreationTime(filePath).ToString("yyyy-MM-dd HH:mm:ss"))</span>
                </div>
                <div class="v-detail-row">
                    <span class="v-detail-label">修改时间</span>
                    <span class="v-detail-value">@(string.IsNullOrEmpty(filePath) ? "-" : File.GetLastWriteTime(filePath).ToString("yyyy-MM-dd HH:mm:ss"))</span>
                </div>
            </div>
        </div>
    }
</div>
