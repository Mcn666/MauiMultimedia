@using System.Diagnostics

<div class="filmstrip-container @(Hidden ? "hidden" : "")">
    <div class="filmstrip-track" @ref="_trackRef">
        @for (int i = 0; i < Items.Count; i++)
        {
            var idx = i;
            var src = Items[i];
            <div class="filmstrip-item @(i == CurrentIndex ? "active" : "")"
                 data-index="@i"
                 @onclick="() => OnItemClick.InvokeAsync(idx)">
                @if (!string.IsNullOrEmpty(src))
                {
                    <img src="@src" alt="" loading="lazy" />
                }
                else
                {
                    <div class="fs-placeholder">@(i + 1)</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;

    [Parameter] public List<string> Items { get; set; } = new();
    [Parameter] public int CurrentIndex { get; set; } = -1;
    [Parameter] public bool Hidden { get; set; }
    [Parameter] public EventCallback<int> OnItemClick { get; set; }
    [Parameter] public float ViewportWidth { get; set; }

    private ElementReference _trackRef;
    private IJSObjectReference? _jsModule;
    private int _lastIndex = -1;
    private int _lastItemCount;
    private float _lastVpWidth;
    private bool _scrolling;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 首次填充 Items（首帧时可能为空）或 CurrentIndex/ViewportWidth 变化 → 居中滚动
        if (!_scrolling && Items.Count > 0 && CurrentIndex >= 0 &&
            (firstRender || _lastIndex != CurrentIndex ||
             _lastItemCount != Items.Count ||
             (_lastVpWidth > 0 && Math.Abs(_lastVpWidth - ViewportWidth) > 1)))
        {
            await ScrollToIndexAsync(CurrentIndex, !firstRender);
            _lastIndex = CurrentIndex;
            _lastItemCount = Items.Count;
            _lastVpWidth = ViewportWidth;
        }
    }

    public async Task ScrollToIndexAsync(int index, bool smooth = false)
    {
        if (Items.Count == 0 || index < 0 || index >= Items.Count) return;
        if (_scrolling) return;
        _scrolling = true;
        try
        {
            if (_jsModule == null)
            {
                var asm = typeof(ImageFilmstrip).Assembly.GetName().Name!;
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import",
                    $"./_content/{asm}/Pages/ImagePage.razor.js");
            }
            // 等一帧确保 DOM 已更新（首次加载或缩略图列表变化后）
            await JS.InvokeVoidAsync("eval", "new Promise(r => requestAnimationFrame(r))");
            await _jsModule.InvokeVoidAsync("scrollFilmstripToElement", _trackRef, index, smooth);
        }
        catch { /* noop */ }
        finally { _scrolling = false; }
    }
}
