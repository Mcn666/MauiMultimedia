<div class="image-toolbar @(Hidden ? "hidden" : "")">
    <div class="toolbar-left">
        <button class="tbar-btn" @onclick="OnGoBack" title="返回 (Esc)">← <span class="tbar-label">返回</span></button>

        <FileNavDropdown FileList="FileList"
                         CurrentIndex="CurrentIndex"
                         StitchMode="StitchMode"
                         OnFileSelected="OnFileSelected" />
    </div>

    <div class="toolbar-right">
        <span class="tbar-zoom-display">@ZoomDisplay</span>
        <button class="tbar-btn tbar-btn-icon" disabled="@ZoomOutDisabled" @onclick="OnZoomOut" title="缩小 (-)">-</button>
        <button class="tbar-btn tbar-btn-icon" disabled="@ZoomInDisabled" @onclick="OnZoomIn" title="放大 (+)">+</button>
        <button class="tbar-btn tbar-btn-toggle @(ZoomFitMode && !StitchMode ? "tbar-btn-active" : "")"
                @onclick="OnToggleFit"
                title="@FitToggleTitle">@FitToggleText</button>

        <div class="tbar-more-wrap">
            <button class="tbar-btn tbar-more-btn" @onclick="ToggleMore" title="更多操作" type="button">⋯</button>

            <div class="tbar-more @(_moreOpen ? "open" : "")">
                @if (ShowStitch)
                {
                    <span class="toolbar-sep"></span>
                    <button class="tbar-btn tbar-btn-toggle @(StitchMode ? "tbar-btn-active" : "")"
                            @onclick="@(() => RunAndClose(OnToggleStitch))" title="拼接模式">
                        <span class="tbar-ico">📐</span><span class="tbar-more-label">拼接模式</span>
                    </button>
                }
            </div>
        </div>

        <span class="toolbar-sep"></span>
        <button class="tbar-btn tbar-btn-toggle tbar-btn-circle" @onclick="OnToggleDetails" title="详情">ℹ</button>
    </div>
    @if (_moreOpen)
    {
        <div class="tbar-more-backdrop" @onclick="CloseMore"></div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> FileList { get; set; } = Array.Empty<string>();
    [Parameter] public int CurrentIndex { get; set; }
    [Parameter] public string ZoomDisplay { get; set; } = "";
    [Parameter] public string FitToggleText { get; set; } = "适应";
    [Parameter] public string FitToggleTitle { get; set; } = "";
    [Parameter] public bool Hidden { get; set; }
    [Parameter] public bool ZoomFitMode { get; set; } = true;
    [Parameter] public bool StitchMode { get; set; }
    [Parameter] public bool ShowStitch { get; set; }
    [Parameter] public bool ZoomOutDisabled { get; set; }
    [Parameter] public bool ZoomInDisabled { get; set; }
    [Parameter] public EventCallback OnGoBack { get; set; }
    [Parameter] public EventCallback<int> OnFileSelected { get; set; }
    [Parameter] public EventCallback OnZoomOut { get; set; }
    [Parameter] public EventCallback OnZoomIn { get; set; }
    [Parameter] public EventCallback OnToggleFit { get; set; }
    [Parameter] public EventCallback OnToggleStitch { get; set; }
    [Parameter] public EventCallback OnToggleDetails { get; set; }

    private bool _moreOpen;
    private void ToggleMore() => _moreOpen = !_moreOpen;
    private void CloseMore() => _moreOpen = false;
    private void RunAndClose(EventCallback cb) { _ = cb.InvokeAsync(); _moreOpen = false; }
}
