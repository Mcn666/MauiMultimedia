@* @page "/textviewer" — 已由 ContentPage 动态加载 *@
@using MauiMultimedia.Core.Abstractions
@using System.Linq
@using System.Text
@inject NavigationManager Navigation
@inject IFileNavigationState NavState
@inject IMauiNavigation MauiNav
@inject IFileLockEncryptionService FileLockService

<div class="viewer-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack">← 返回</button>
        <button class="v-btn v-btn-nav" disabled="@(hasPrev ? null : true)" @onclick="GoPrev">←</button>
        <span class="v-title" title="@filePath">@fileName</span>
        <button class="v-btn v-btn-nav" disabled="@(hasNext ? null : true)" @onclick="GoNext">→</button>
    </div>

    @if (isLoading)
    {
        <div class="viewer-loading"><div class="spinner"></div><span>正在加载...</span></div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="viewer-error">⚠️ @errorMessage</div>
    }
    else
    {
        <pre class="viewer-content"><code>@fileContent</code></pre>
    }
</div>

@code {
    private static readonly HashSet<string> Exts = new(StringComparer.OrdinalIgnoreCase)
    {
        ".txt", ".log", ".md", ".csv", ".xml", ".json", ".yaml", ".yml",
        ".cs", ".js", ".ts", ".jsx", ".tsx", ".css", ".scss", ".less",
        ".html", ".htm", ".php", ".py", ".java", ".cpp", ".c", ".h",
        ".sql", ".sh", ".bat", ".ps1", ".rb", ".go", ".rs", ".swift",
        ".ini", ".cfg", ".conf", ".env", ".gitignore", ".dockerfile",
        ".csproj", ".sln", ".slnx", ".props", ".targets"
    };

    private string filePath = "";
    private string fileName = "";
    private string fileContent = "";
    private bool isLoading = true;
    private string? errorMessage;
    private List<string> fileList = new();
    private int currentIndex = -1;
    private bool hasPrev => currentIndex > 0;
    private bool hasNext => currentIndex >= 0 && currentIndex < fileList.Count - 1;

    protected override async Task OnInitializedAsync()
    {
        fileList = NavState.CurrentDirectoryFiles?
            .Where(f => Exts.Contains(Path.GetExtension(f))).ToList() ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        filePath = NavState.CurrentFilePath
            ?? uri.Query.TrimStart('?').Split('&')
                .Select(p => p.Split('=', 2))
                .Where(kv => kv.Length == 2 && kv[0] == "path")
                .Select(kv => Uri.UnescapeDataString(kv[1]))
                .FirstOrDefault() ?? "";
        fileName = Path.GetFileName(filePath);
        currentIndex = fileList.FindIndex(f => string.Equals(f, filePath, StringComparison.OrdinalIgnoreCase));

        if (string.IsNullOrEmpty(filePath))
        {
            errorMessage = "未指定文件路径";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;
        try
        {
            fileContent = await Task.Run(async () =>
            {
                var bytes = await FileLockService.ReadDecryptedBytesAsync(filePath);
                return Encoding.UTF8.GetString(bytes);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"读取文件失败：{ex.Message}";
            fileContent = "";
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    private void GoBack()
    {
        _ = MauiNav.GoBackAsync();
    }
    private void GoPrev()
    {
        if (!hasPrev) return;
        currentIndex--; filePath = fileList[currentIndex]; fileName = Path.GetFileName(filePath);
        _ = LoadFileContentAsync();
    }
    private void GoNext()
    {
        if (!hasNext) return;
        currentIndex++; filePath = fileList[currentIndex]; fileName = Path.GetFileName(filePath);
        _ = LoadFileContentAsync();
    }
    private async Task LoadFileContentAsync()
    {
        isLoading = true; errorMessage = null;
        try
        {
            fileContent = await Task.Run(async () =>
            {
                var bytes = await FileLockService.ReadDecryptedBytesAsync(filePath);
                return Encoding.UTF8.GetString(bytes);
            });
        }
        catch (Exception ex)
        {
            errorMessage = $"读取文件失败：{ex.Message}";
            fileContent = "";
        }
        finally { isLoading = false; StateHasChanged(); }
    }
}
