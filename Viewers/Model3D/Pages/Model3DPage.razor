@* @page "/model3dviewer" — 已由 ContentPage 动态加载 *@

<div class="viewer-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack">← 返回</button>
        <FileNavDropdown FileList="fileList" CurrentIndex="currentIndex" OnFileSelected="OnFileSelected" />
    </div>

    @if (isLoading)
    {
        <div class="viewer-loading"><div class="spinner"></div><span>正在加载 3D 模型...</span></div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="viewer-error">⚠️ @errorMessage</div>
    }
    else if (_isGlb)
    {
        <div class="model-container">
            <model-viewer src="@_modelUrl" alt="@fileName"
                          auto-rotate camera-controls
                          ar ar-modes="webxr scene-viewer quick-look"
                          environment-image="neutral"
                          shadow-intensity="1"
                          style="width:100%;height:100%;">
            </model-viewer>
        </div>
    }
    else
    {
        <div class="model-container">
            <canvas id="three-canvas" style="width:100%;height:100%;display:block;"></canvas>
        </div>
    }
</div>
