@* @page "/model3dviewer" — 已由 ContentPage 动态加载 *@

<div class="viewer-page">
    <div class="v-toolbar">
        <button class="v-btn" @onclick="GoBack">← 返回</button>
        <FileNavDropdown FileList="fileList" CurrentIndex="currentIndex" OnFileSelected="OnFileSelected" />
        <span class="v-sep"></span>
        <button class="v-btn @(_lightsOn ? "active" : "")" @onclick="ToggleLights">灯光</button>
        <button class="v-btn @(_gridOn ? "active" : "")" @onclick="ToggleGrid">网格</button>
    </div>

    @* canvas 必须常驻，不能放进 isLoading/error 条件分支：
       切换模型时 isLoading 会在 true→false 间变化，若 canvas 随分支增删，
       Blazor 重渲染会把它当作新节点重建，导致 initViewer 绑定的 renderer 指向已脱离 DOM 的旧 canvas，
       渲染循环仍在跑却画到死 canvas 上 → 视口全黑。故 canvas 始终渲染，浮层只覆盖其上。 *@
    <div class="model-container">
        <canvas id="three-canvas" style="width:100%;height:100%;display:block;"></canvas>
        @if (isLoading)
        {
            <div class="viewer-loading"><div class="spinner"></div><span>正在加载 3D 模型...</span></div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="viewer-error">⚠️ @errorMessage</div>
        }
    </div>
</div>
