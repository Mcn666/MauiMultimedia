@page "/"
@using System.IO
@using MauiMultimedia.Core.Abstractions
@using MauiMultimedia.Shell.Services
@inject IFileSystemService FileSystemService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IEnumerable<IViewProvider> ViewProviders
@inject IEnumerable<IFileViewer> FileViewers
@inject FileBrowserStateService BrowserState

<div class="file-browser">
    <div class="browser-layout">
        @* 侧边栏：Windows 快捷访问 *@
        @if (OperatingSystem.IsWindows())
        {
            <aside class="browser-sidebar">
                <div class="sidebar-header">📌 快速访问</div>
                <button class="sidebar-item" @onclick="() => NavigateToQuickAccess(WindowsQuickAccess.Desktop)">🖥️ 桌面</button>
                <button class="sidebar-item" @onclick="() => NavigateToQuickAccess(WindowsQuickAccess.Downloads)">📥 下载</button>
                <button class="sidebar-item" @onclick="() => NavigateToQuickAccess(WindowsQuickAccess.Documents)">📄 文档</button>
                <button class="sidebar-item" @onclick="() => NavigateToQuickAccess(WindowsQuickAccess.Pictures)">🖼️ 图片</button>
                <button class="sidebar-item" @onclick="() => NavigateToQuickAccess(WindowsQuickAccess.Music)">🎵 音乐</button>
                <button class="sidebar-item" @onclick="() => NavigateToQuickAccess(WindowsQuickAccess.Videos)">🎬 视频</button>
            </aside>
        }

        @* 主内容区 *@
        <main class="browser-main">
            <div class="browser-header">
                <div class="path-bar">
                    <span class="path-label">📂 当前位置：</span>
                    <span class="path-text" title="@currentPath">@currentPath</span>
                    <span class="path-short" title="@currentPath">@Path.GetFileName(currentPath.TrimEnd('\\'))</span>
                </div>
                <div class="browser-actions">
                    <button class="btn btn-back" disabled="@isRoot" @onclick="GoBack">
                        ⬆ 返回上级
                    </button>
                    <button class="btn btn-scan-panel" @onclick="ToggleScanPanel" title="文件筛选">⋮</button>
                </div>
            </div>

            @* 扫描类型筛选面板 *@
            <div class="scan-panel @(showScanPanel ? "open" : "")">
                <div class="scan-panel-header">
                    <span>📂 文件筛选</span>
                    <button class="scan-panel-close" @onclick="CloseScanPanel">✕</button>
                </div>
                <div class="scan-panel-body">
                    @foreach (var cat in scanCategories)
                    {
                        var idx = scanCategories.IndexOf(cat) + 1;
                        <button class="scan-type-btn" @onclick="() => StartScan(idx)">@cat.Icon @cat.Label</button>
                    }
                </div>
            </div>
            @if (showScanPanel)
            {
                <div class="scan-overlay" @onclick="CloseScanPanel"></div>
            }

            @* 排序栏 *@
            <div class="sort-bar">
                <button class="btn-sort @GetSortClass("name")" @onclick="OnSortByName" title="按名称排序">
                    名称 @GetSortArrow("name")
                </button>
                <span class="sort-sep"></span>
                <button class="btn-sort @GetSortClass("type")" @onclick="OnSortByType" title="按类型排序">
                    类型 @GetSortArrow("type")
                </button>
                <span class="sort-sep"></span>
                <button class="btn-sort @GetSortClass("count")" @onclick="OnSortByCount" title="按项目数排序">
                    项目数 @GetSortArrow("count")
                </button>
                <span class="sort-sep"></span>
                <button class="btn-sort @GetSortClass("date")" @onclick="OnSortByDate" title="按修改时间排序">
                    修改时间 @GetSortArrow("date")
                </button>
                <span class="sort-bar-spacer"></span>
                <div class="theme-dropdown"
                     @onmouseenter="() => showThemeMenu = true"
                     @onmouseleave="() => showThemeMenu = false">
                    <button class="btn-sort-icon" @onclick="() => showThemeMenu = !showThemeMenu" title="切换主题">
                        @(themeMode == "light" ? "☀️" : themeMode == "dark" ? "🌙" : "🖥️")
                    </button>
                    <div class="theme-menu @(showThemeMenu ? "open" : "")">
                        <button class="theme-option @(themeMode == "light" ? "active" : "")" @onclick="SetThemeLight">☀️ 浅色</button>
                        <button class="theme-option @(themeMode == "dark" ? "active" : "")" @onclick="SetThemeDark">🌙 深色</button>
                        <button class="theme-option @(themeMode == "system" ? "active" : "")" @onclick="SetThemeSystem">🖥️ 跟随系统</button>
                    </div>
                </div>
                <button class="btn-sort-icon" @onclick="ToggleViewMode" title="@(viewMode == "list" ? "切换网格视图" : "切换列表视图")">
                    @(viewMode == "list" ? "▦" : "☰")
                </button>
            </div>

            @if (isLoading)
    {
        if (isScanning)
        {
            <div class="browser-loading">
                <div class="spinner"></div>
                <span>正在扫描 @scanTypeLabel...</span>
            </div>
        }
        else
        {
            <div class="browser-loading">
                <div class="spinner"></div>
                <span>正在加载...</span>
            </div>
        }
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="browser-error">
            ⚠️ @errorMessage
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="browser-empty">
            @(isScanned ? $"未找到{scanTypeLabel ?? ""}文件" : "📭 此文件夹为空")
        </div>
    }
    else
    {
        @if (isScanned)
        {
            <div class="scan-header">
                <button class="btn btn-back" style="font-size:13px;padding:4px 10px;" @onclick="ExitScan">← 返回浏览</button>
                <span style="font-size:13px;color:var(--text-secondary);">@scanTypeLabel (@items.Count 个文件)</span>
            </div>
        }
        @if (viewMode == "grid")
    {
        <div class="browser-grid">
            @foreach (var item in items)
            {
                <div class="grid-item @GetItemRowClass(item)"
                     @onclick="() => OnItemClick(item)"
                     @onkeydown="() => {}"
                     role="button"
                     tabindex="0"
                     title="@item.FullPath">
                    @{
                        var snap = GetItemSnapshot(item);
                    }
                    @if (snap != null)
                    {
                        <div class="grid-thumb">
                            <img src="@snap" class="grid-thumb-img" alt="" loading="lazy" />
                            <div class="grid-thumb-label">@item.Name</div>
                        </div>
                    }
                    else if (CanProvideSnapshot(item))
                    {
                        <div class="grid-thumb" data-thumb-path="@item.FullPath">
                            <div class="grid-thumb-placeholder-icon">@GetItemIcon(item)</div>
                            <div class="grid-thumb-label">@item.Name</div>
                        </div>
                    }
                    else
                    {
                        <span class="grid-icon">@GetItemIcon(item)</span>
                        <span class="grid-name">@item.Name</span>
                        <span class="grid-count">@item.ChildCountDisplay</span>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="browser-items">
            <div class="items-header">
                <span class="col-icon"></span>
                <span class="col-name sortable" @onclick="OnSortByName">
                    名称 @GetSortArrow("name")
                </span>
                <span class="col-count sortable" @onclick="OnSortByCount">
                    项目数 @GetSortArrow("count")
                </span>
                <span class="col-date sortable" @onclick="OnSortByDate">
                    修改时间 @GetSortArrow("date")
                </span>
            </div>
            @foreach (var item in items)
            {
                <div class="item-row @GetItemRowClass(item)"
                     @onclick="() => OnItemClick(item)"
                     @onkeydown="() => {}"
                     role="button"
                     tabindex="0"
                     title="@item.FullPath">
                    <span class="col-icon item-icon">@GetItemIcon(item)</span>
                    <span class="col-name item-name">@item.Name</span>
                    <span class="col-count item-count">@item.ChildCountDisplay</span>
                    <span class="col-date item-date">@item.LastModifiedDisplay</span>
                </div>
            }
        </div>
    }
    }
    </main>
</div>
</div>

@* 多查看器选择模态框 *@
@if (permissionDenied)
{
    <div class="picker-overlay" @onclick:stopPropagation="true">
        <div class="picker-modal" @onclick:stopPropagation="true">
            <div class="picker-header">
                <span class="picker-title">🔒 需要存储权限</span>
            </div>
            <div class="picker-body" style="padding:20px 24px;gap:12px;">
                <div style="font-size:14px;color:var(--text-secondary);line-height:1.6;">
                    此应用需要访问设备存储来浏览文件。请点击下方按钮前往系统设置开启权限。
                </div>
                <button class="btn btn-back" style="width:100%;justify-content:center;padding:10px;"
                        @onclick="RequestStorageAccess">
                    前往设置
                </button>
            </div>
        </div>
    </div>
}
else if (showViewerPicker && pendingItem != null)
{
    <div class="picker-overlay" @onclick="CloseViewerPicker" @onkeydown="() => {}">
        <div class="picker-modal" @onclick:stopPropagation="true">
            <div class="picker-header">
                <span class="picker-title">📄 打开方式</span>
                <button class="picker-close" @onclick="CloseViewerPicker">✕</button>
            </div>
            <div class="picker-body">
                <div class="picker-file">@pendingItem.Name</div>
                <div class="picker-list">
                    @foreach (var v in availableViewers)
                    {
                        <button class="picker-item" @onclick="() => OpenWithViewer(v)">
                            <span class="picker-item-icon">🔗</span>
                            <span class="picker-item-name">@GetViewerDisplayName(v)</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

