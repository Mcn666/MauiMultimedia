@page "/"
@using MauiMultimedia.Shell.Models
@using MauiMultimedia.Shell.Services
@inject IFileSystemService FileSystemService
@inject IJSRuntime JS

<div class="file-browser">
    <div class="browser-header">
        <div class="path-bar">
            <span class="path-label">📂 当前位置：</span>
            <span class="path-text" title="@currentPath">@currentPath</span>
        </div>
        <div class="browser-actions">
            <button class="btn btn-theme" @onclick="ToggleTheme" title="切换主题">
                @(isDarkTheme ? "☀️" : "🌙")
            </button>
            <button class="btn btn-view" @onclick="ToggleViewMode" title="@(viewMode == "list" ? "切换网格视图" : "切换列表视图")">
                @(viewMode == "list" ? "▦" : "☰")
            </button>
            <button class="btn btn-back" disabled="@isRoot" @onclick="GoBack">
                ⬆ 返回上级
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="browser-loading">
            <div class="spinner"></div>
            <span>正在加载...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="browser-error">
            ⚠️ @errorMessage
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="browser-empty">
            📭 此文件夹为空
        </div>
    }
    else if (viewMode == "grid")
    {
        <div class="browser-grid">
            @foreach (var item in items)
            {
                <div class="grid-item @(item.IsFolder ? "folder" : "file")"
                     @onclick="() => OnItemClick(item)"
                     @onkeydown="() => {}"
                     role="button"
                     tabindex="0"
                     title="@item.FullPath">
                    <span class="grid-icon">@item.Icon</span>
                    <span class="grid-name">@item.Name</span>
                    <span class="grid-count">@item.ChildCountDisplay</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="browser-items">
            <div class="items-header">
                <span class="col-icon"></span>
                <span class="col-name">名称</span>
                <span class="col-count">项目数</span>
                <span class="col-date">修改时间</span>
            </div>
            @foreach (var item in items)
            {
                <div class="item-row @(item.IsFolder ? "folder" : "file")"
                     @onclick="() => OnItemClick(item)"
                     @onkeydown="() => {}"
                     role="button"
                     tabindex="0"
                     title="@item.FullPath">
                    <span class="col-icon item-icon">@item.Icon</span>
                    <span class="col-name item-name">@item.Name</span>
                    <span class="col-count item-count">@item.ChildCountDisplay</span>
                    <span class="col-date item-date">@item.LastModifiedDisplay</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private string currentPath = "";
    private List<FileSystemItem> items = new();
    private bool isLoading = true;
    private bool isRoot = false;
    private string? errorMessage;
    private bool isDarkTheme = false;
    private string viewMode = "list"; // "list" | "grid"

    protected override async Task OnInitializedAsync()
    {
        currentPath = FileSystemService.GetDefaultPath();
        await LoadItemsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreThemeAsync();
            await RestoreViewModeAsync();
            StateHasChanged();
        }
    }

    private async Task RestoreThemeAsync()
    {
        // 从 localStorage 读取用户之前保存的主题偏好
        var saved = await JS.InvokeAsync<string>("eval", "localStorage.getItem('filebrowser-theme')");

        if (saved == "dark")
        {
            await JS.InvokeVoidAsync("eval", "document.documentElement.setAttribute('data-theme','dark')");
            isDarkTheme = true;
        }
        else if (saved == "light")
        {
            await JS.InvokeVoidAsync("eval", "document.documentElement.setAttribute('data-theme','light')");
            isDarkTheme = false;
        }
        else
        {
            // 无手动设置 → 跟随系统主题
            var auto = await JS.InvokeAsync<bool>("eval", "window.matchMedia('(prefers-color-scheme: dark)').matches");
            isDarkTheme = auto;
        }
    }

    private async Task LoadItemsAsync()
    {
        isLoading = true;
        errorMessage = null;
        isRoot = FileSystemService.IsRootPath(currentPath);

        try
        {
            items = await FileSystemService.ListItemsAsync(currentPath);
            // 在后台异步加载每个文件夹的子项目数量
            _ = LoadChildCountsAsync(items);
        }
        catch (Exception ex)
        {
            errorMessage = $"加载目录失败：{ex.Message}";
            items = new List<FileSystemItem>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadChildCountsAsync(List<FileSystemItem> folderItems)
    {
        var folders = folderItems.Where(i => i.IsFolder).ToList();
        // 限制并发数，避免大量文件夹时开销过大
        var semaphore = new SemaphoreSlim(4);
        var tasks = folders.Select(async item =>
        {
            await semaphore.WaitAsync();
            try
            {
                var count = await Task.Run(() => FileSystemService.TryGetChildCount(item.FullPath));
                item.ChildCount = count;
            }
            catch
            {
                item.ChildCount = -1;
            }
            finally
            {
                semaphore.Release();
            }
            await InvokeAsync(StateHasChanged);
        });
        await Task.WhenAll(tasks);
    }

    private void OnItemClick(FileSystemItem item)
    {
        if (item.IsFolder)
        {
            currentPath = item.FullPath;
            _ = LoadItemsAsync();
        }
    }

    private async Task GoBack()
    {
        var parent = FileSystemService.GetParentPath(currentPath);
        if (parent != null)
        {
            currentPath = parent;
            await LoadItemsAsync();
        }
    }

    private async Task RestoreViewModeAsync()
    {
        var saved = await JS.InvokeAsync<string>("eval", "localStorage.getItem('filebrowser-view')");
        if (saved == "grid" || saved == "list")
        {
            viewMode = saved;
        }
    }

    private async Task ToggleViewMode()
    {
        viewMode = (viewMode == "list") ? "grid" : "list";
        await JS.InvokeVoidAsync("eval", $"localStorage.setItem('filebrowser-view','{viewMode}')");
    }

    private async Task ToggleTheme()
    {
        if (isDarkTheme)
        {
            // 当前暗色 → 切到亮色
            await JS.InvokeVoidAsync("eval", "document.documentElement.setAttribute('data-theme','light')");
            await JS.InvokeVoidAsync("eval", "localStorage.setItem('filebrowser-theme','light')");
            isDarkTheme = false;
        }
        else
        {
            // 当前亮色 → 切到暗色
            await JS.InvokeVoidAsync("eval", "document.documentElement.setAttribute('data-theme','dark')");
            await JS.InvokeVoidAsync("eval", "localStorage.setItem('filebrowser-theme','dark')");
            isDarkTheme = true;
        }
    }
}
